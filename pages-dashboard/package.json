  "overrides": {
    "@babel/core": "7.29.6",
    "brace-expansion": "^5.0.9",
    "esbuild": "0.28.1",
    "flatted": "^3.4.1",
    "postcss": "^8.5.23",
    "undici": "^7.29.0"
  }
